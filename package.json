{
  "name": "js-bundler-benchmark",
  "version": "1.0.0",
  "private": true,
  "description": "Empirical Evaluation of Rust-Based JavaScript Bundlers — Replication Package",
  "type": "module",
  "scripts": {
    "protocol:generate": "node scripts/generate-confirmatory-schedule.mjs",
    "protocol:audit": "node scripts/audit-confirmatory-protocol.mjs",
    "protocol:v2-cloud:generate": "node scripts/generate-confirmatory-v2-cloud-schedule.mjs",
    "protocol:v2-cloud:audit": "node scripts/audit-confirmatory-v2-cloud-draft.mjs",
    "cloud-runner:inspect": "node scripts/inspect-cloud-macos-runner.mjs",
    "cloud-capacity:validate": "node scripts/validate-cloud-capacity-evidence.mjs",
    "cloud-workspace-seal:test": "node scripts/cloud-cell-workspace-seal.test.mjs",
    "incremental-session:test": "node scripts/confirmatory-incremental-session.test.mjs",
    "incremental-session:validate-controls": "node scripts/validate-m3-session-controls.mjs",
    "campaign:host": "node scripts/confirmatory-campaign.mjs inspect-host --observe-seconds 60",
    "campaign:test": "node scripts/test-confirmatory-campaign.mjs",
    "incremental-gate:test": "node scripts/incremental-completion-gate.test.mjs",
    "incremental-harness:test": "node scripts/check-incremental-correctness.test.mjs",
    "collector-controls:test": "node scripts/confirmatory-cell-acceptance.test.mjs",
    "production-executor:check": "node --check scripts/confirmatory-production-cell.mjs && node --check scripts/confirmatory-production-block.mjs && node scripts/confirmatory-workspace-contract.test.mjs",
    "development-executor:check": "node --check scripts/confirmatory-development-cell.mjs && node --check scripts/confirmatory-development-block.mjs",
    "generate:xs": "tsx tier1-synthetic/generate-project.ts --size 50 --seed 42 --output tier1-synthetic/projects/xs-50",
    "generate:s": "tsx tier1-synthetic/generate-project.ts --size 200 --seed 42 --output tier1-synthetic/projects/s-200",
    "generate:m": "tsx tier1-synthetic/generate-project.ts --size 500 --seed 42 --output tier1-synthetic/projects/m-500",
    "generate:l": "tsx tier1-synthetic/generate-project.ts --size 2000 --seed 42 --output tier1-synthetic/projects/l-2000",
    "generate:xl": "tsx tier1-synthetic/generate-project.ts --size 5000 --seed 42 --output tier1-synthetic/projects/xl-5000",
    "generate:all": "npm run generate:xs && npm run generate:s && npm run generate:m && npm run generate:l && npm run generate:xl"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "jstat": "^1.9.6",
    "puppeteer": "^25.10.0",
    "simple-statistics": "^7.12.0",
    "source-map": "^0.8.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
